# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_DB=notes
POSTGRES_HOST=localhost
PORT=5432

# LibreDB Studio
LIBREDB_ADMIN_EMAIL=jonh.doe@mymail.com
LIBREDB_ADMIN_PASSWORD=75Cf$997
LIBREDB_JWT_SECRET=blkuNPOVKnFUZ2uzTAhXKkr2zIuajrEZ0aG1j78OOYA=

# Silo (the images of the notes): note-silo:9000 in .env.docker
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=notes
S3_SECRET_KEY=
S3_BUCKET=notes

# API
# Origin of the web app allowed to call the API, e.g. http://localhost:3000
WEB_ORIGIN=
# How accounts are created: invitation (an admin invites them) or public (anyone reaching the web app)
NOTES_ADD_USER_MODE=invitation

# Config
CONFIG_FILE=config/config.yaml
# Encryption key of the notes (openssl rand -base64 32), the same in .env.docker: keep a copy in a password
# manager, never in a backup. Lost = notes unreadable.
NOTES_SECRET=
