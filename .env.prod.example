# Copy to .env next to compose.prod.yaml on the server.
# Empty passwords, NOTES_SECRET and LIBREDB_JWT_SECRET: fill each with `openssl rand -base64 32`.

# Version of the image: latest, or a tag like 0.27.0.
NOTES_VERSION=latest
# The exact address typed in the browser, with no trailing slash: requests from any other page are refused.
WEB_ORIGIN=https://notes.example.com
# Where Notes listens, in plain HTTP: the HTTPS proxy in front points here.
NOTES_LISTEN=127.0.0.1:8080

POSTGRES_USER=notes
POSTGRES_PASSWORD=
POSTGRES_DB=notes

S3_ACCESS_KEY=notes
S3_SECRET_KEY=
S3_BUCKET=notes

# How accounts are created: invitation (an admin invites or creates them from the settings) or public (anyone
# reaching the web app). The first account to sign up on an empty base is the admin.
NOTES_ADD_USER_MODE=invitation
# That first account, created at startup while the base has none: then log in with it and empty both lines.
NOTES_HOST_NAME=
NOTES_HOST_PASSWORD=

# Encryption key of the notes: keep a copy in a password manager, never in a backup. Lost = notes unreadable.
NOTES_SECRET=

# The dashboard of the base (LibreDB Studio), on the loopback like Notes.
LIBREDB_LISTEN=127.0.0.1:3001
LIBREDB_ADMIN_EMAIL=admin@libredb.org
LIBREDB_ADMIN_PASSWORD=
LIBREDB_JWT_SECRET=
