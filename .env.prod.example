# Copy to .env next to compose.prod.yaml on the server.
NOTES_VERSION=latest
WEB_ORIGIN=https://notes.example.com
# NOTES_LISTEN=127.0.0.1:8080

POSTGRES_USER=notes
POSTGRES_PASSWORD=
POSTGRES_DB=notes

S3_ACCESS_KEY=notes
S3_SECRET_KEY=
S3_BUCKET=notes

# Encryption key of the notes (openssl rand -base64 32): keep a copy in a password manager. Lost = notes unreadable.
NOTES_SECRET=
